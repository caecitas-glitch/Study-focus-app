<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header with Emoji Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDialogAppEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Name"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogAppPkg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="com.example.app"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/card_border" />

    <!-- Toggle: Block during Study Sessions -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchStudyBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="🚫 Block during Study Sessions"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <!-- Toggle: Late Night Warning (after 9 PM) -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchLateNight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🌙 Warn if used after 9:00 PM"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SESSION USAGE LIMIT (PER SITTING)"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Limits continuous use per sitting. Resets after a 15-minute break."
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Limit Quick Chips / Buttons -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipLimitOff"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Off"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                app:strokeColor="@color/card_border" />

            <Button
                android:id="@+id/chipLimit15"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="15m"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                app:strokeColor="@color/card_border" />

            <Button
                android:id="@+id/chipLimit30"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="30m"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                app:strokeColor="@color/card_border" />

            <Button
                android:id="@+id/chipLimit45"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="45m"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                app:strokeColor="@color/card_border" />

            <Button
                android:id="@+id/chipLimit60"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="60m"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                app:strokeColor="@color/card_border" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Custom Minute Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Or set custom minutes:"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etCustomMinutes"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/card_overlay_bg"
            android:gravity="center"
            android:hint="mins"
            android:inputType="number"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelDialog"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancel"
            android:textColor="@color/text_muted" />

        <Button
            android:id="@+id/btnSaveDialog"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_primary"
            android:text="Save Rules"
            android:textColor="@color/text_main"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
